{
  "hosting": {
    "target": "elclan",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "README.md", ".htaccess", ".vscode/**"],
    "headers": [
      { "source": "**/*.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" }, { "key": "X-Content-Type-Options", "value": "nosniff" } ] },
      { "source": "**/*.@(js|css)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
      { "source": "**/*.@(svg|png|jpg|webp|ico)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] }
    ]
  }
}
